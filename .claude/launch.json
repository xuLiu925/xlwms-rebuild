{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "D:/java/apache-maven-3.9.9/bin/mvn.cmd",
      "runtimeArgs": [
        "-f",
        "D:/java/xlwms-rebuild/backend/pom.xml",
        "spring-boot:run"
      ],
      "env": {
        "JAVA_HOME": "D:/java/java-17.0.1"
      },
      "port": 8080
    },
    {
      "name": "backend-h2",
      "runtimeExecutable": "D:/java/apache-maven-3.9.9/bin/mvn.cmd",
      "runtimeArgs": [
        "-f",
        "D:/java/xlwms-rebuild/backend/pom.xml",
        "spring-boot:run",
        "-Dspring-boot.run.useTestClasspath=true",
        "-Dspring-boot.run.arguments=--spring.config.additional-location=file:D:/java/xlwms-rebuild/backend/src/test/resources/application-h2.yml"
      ],
      "env": {
        "JAVA_HOME": "D:/java/java-17.0.1"
      },
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "D:/java/nodejs/npm.cmd",
      "runtimeArgs": [
        "--prefix",
        "D:/java/xlwms-rebuild/frontend",
        "run",
        "serve",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
